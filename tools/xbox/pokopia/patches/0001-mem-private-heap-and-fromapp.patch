+// [memory] heap_backing = private: a private reservation at kHeapBase. Commit, decommit (pages really freed, zero on recommit),
+// protect, and every view of the heap refused.
+NXTEST(private_heap_commit_decommit_and_no_views) {
+    mem::shutdown();
+    nxrt::config_set("memory", "heap_backing", "private");
+    CHECK(mem::init());
+    CHECK(mem::heap_create(kHeapSmall));
+    CHECK(mem::heap_exists());
+    CHECK(!mem::heap_has_views());
+    CHECK_EQ(mem::heap_reserved(), kHeapSmall);
+    MEMORY_BASIC_INFORMATION mbi{};
+    CHECK(VirtualQuery(reinterpret_cast<void*>(mem::kHeapBase), &mbi, sizeof mbi) == sizeof mbi);
+    CHECK_EQ(static_cast<uint64_t>(mbi.Type), static_cast<uint64_t>(MEM_PRIVATE));
+    CHECK(!mem::is_mapped(mem::kHeapBase, kPg));
+    CHECK(mem::heap_commit(0, 4 * kPg));
+    CHECK_EQ(mem::heap_committed(), 4 * kPg);
+    CHECK(mem::is_mapped(mem::kHeapBase, 4 * kPg));
+    word_at(mem::kHeapBase + kPg)[3] = 0xBEEF0001u;
+    CHECK(mem::protect(mem::kHeapBase, kPg, mem::Prot::R));
+    CHECK(touch(mem::kHeapBase, false));
+    CHECK(!touch(mem::kHeapBase, true));
+    CHECK(mem::protect(mem::kHeapBase, kPg, mem::Prot::RW));
+    CHECK(mem::heap_decommit(kPg, 3 * kPg));
+    CHECK_EQ(mem::heap_committed(), kPg);
+    CHECK(!host_mapped(mem::kHeapBase + kPg, kPg));     // really decommitted, not only no-access
+    CHECK(!mem::is_mapped(mem::kHeapBase + kPg, kPg));
+    CHECK(!touch(mem::kHeapBase + kPg, false));
+    CHECK(!mem::protect(mem::kHeapBase + kPg, kPg, mem::Prot::R));   // decommitted pages cannot be reprotected
+    CHECK(mem::heap_commit(kPg, kPg));
+    CHECK_EQ(word_at(mem::kHeapBase + kPg)[3], 0u);     // a recommitted private page is zero
+    CHECK_EQ(mem::heap_alias(0, kGr, 0, mem::Prot::RW), 0ull);
+    CHECK_EQ(mem::heap_alias_count(), 0u);
+    CHECK(mem::heap_private_view(0, kGr) == nullptr);
+    uint64_t off = 1;
+    CHECK(mem::heap_offset_of(mem::kHeapBase + 5 * kPg, &off));
+    CHECK_EQ(off, 5 * kPg);
+    mem::shutdown();
+    CHECK(!mem::heap_exists());
+    CHECK(host_mapped(mem::kHeapBase, kPg) == false);
+    // the next heap is a section again
+    nxrt::config_set("memory", "heap_backing", "section");
+    CHECK(mem::init());
+    CHECK(mem::heap_create(kHeapSmall));
+    CHECK(mem::heap_has_views());
+    mem::shutdown();
+}
