diff --git a/runtime/include/nxrt/host_vm.h b/runtime/include/nxrt/host_vm.h
new file mode 100644
index 0000000..8c17ea1
--- /dev/null
+++ b/runtime/include/nxrt/host_vm.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Host virtual-memory calls of the runtime, in one place so a UWP (AppContainer) build can use the variants the sandbox allows.
+// With NXRT_UWP defined: VirtualAllocFromApp and VirtualProtectFromApp, and executable protections become their non-executable
+// counterparts (lifted code runs from the exe; guest pages are only data to the host, and an AppContainer without the codeGeneration
+// capability refuses executable pages). Without it: the plain calls, unchanged.
+#pragma once
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+namespace nxrt::hostvm {
+
+inline DWORD page_protect(DWORD p) {
+#if defined(NXRT_UWP)
+    switch (p & 0xFF) {
+        case PAGE_EXECUTE: return (p & ~0xFFu) | PAGE_NOACCESS;
+        case PAGE_EXECUTE_READ: return (p & ~0xFFu) | PAGE_READONLY;
+        case PAGE_EXECUTE_READWRITE: return (p & ~0xFFu) | PAGE_READWRITE;
+        case PAGE_EXECUTE_WRITECOPY: return (p & ~0xFFu) | PAGE_WRITECOPY;
+        default: break;
+    }
+#endif
+    return p;
+}
+
+inline void* alloc(void* addr, SIZE_T size, DWORD type, DWORD protect) {
+#if defined(NXRT_UWP)
+    return VirtualAllocFromApp(addr, size, type, page_protect(protect));
+#else
+    return VirtualAlloc(addr, size, type, protect);
+#endif
+}
+
+inline BOOL protect(void* addr, SIZE_T size, DWORD protect, DWORD* old) {
+#if defined(NXRT_UWP)
+    ULONG o = 0;
+    const BOOL ok = VirtualProtectFromApp(addr, size, page_protect(protect), &o);
+    if (old) *old = o;
+    return ok;
+#else
+    return VirtualProtect(addr, size, protect, old);
+#endif
+}
+
+}  // namespace nxrt::hostvm
